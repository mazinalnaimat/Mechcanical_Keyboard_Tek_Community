<Page
    x:Class="Tek_Mechanical_Keyboard.UI.Keymap_Page.KeymapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Keymap"
    Background="{StaticResource PageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/KeymapStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="10" Background="#FF353535">
        <TabControl
            Margin="299,337,0,0"
            BorderBrush="#CCCCCC"
            BorderThickness="4"
            SelectionChanged="TabControl_SelectionChanged_1">
            <TabItem Header="Basic">
                <StackPanel Margin="15" />
            </TabItem>

            <TabItem Header="Media">
                <StackPanel Margin="15" />
            </TabItem>

            <TabItem Header="Macro">
                <StackPanel Margin="15" />
            </TabItem>

            <TabItem Header="Layer">
                <StackPanel Margin="15" />
            </TabItem>

            <TabItem Header="Lighting">
                <StackPanel Margin="15" />
            </TabItem>

            <TabItem Header="System">
                <StackPanel Margin="15" />
            </TabItem>
        </TabControl>

        <TabControl
            Margin="20,337,586,10"
            BorderBrush="#CCCCCC"
            BorderThickness="4">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Padding="16,8"
                            Background="{StaticResource Win11DarkSelectedTabBg}"
                            CornerRadius="6">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display, Segoe UI"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#4CC2FF"
                                Text="Key Control" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="15" />
            </TabItem>
        </TabControl>
    </Grid>

</Page>
