<Application
    x:Class="Tek_Mechanical_Keyboard.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#181818" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#202020" />
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#242424" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1C1C1C" />
        <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#2C2C2C" />
        <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#292929" />
        <SolidColorBrush x:Key="AccentBrush" Color="#22A7E8" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F1F1" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BDBDBD" />
        <SolidColorBrush x:Key="BorderBrush" Color="#303030" />
    </Application.Resources>
</Application>
