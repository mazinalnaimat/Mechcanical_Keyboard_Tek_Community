<UserControl
    x:Class="Tek_Mechanical_Keyboard.UI.Pages.Layers.Controls.ModifierButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Focusable="False">
    <Button
        Padding="5"
        BorderThickness="1"
        Command="{Binding SelectCommand, ElementName=Root}"
        CommandParameter="{Binding}"
        Cursor="Hand">
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#282E33" />
                <Setter Property="BorderBrush" Value="#45535D" />
                <Setter Property="Foreground" Value="#E5F5FC" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#303B43" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#173D50" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>
        <StackPanel VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="10"
                FontWeight="SemiBold"
                Text="{Binding Legend}" />
            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontSize="8"
                Foreground="#9EC5D7"
                Text="{Binding Action.Code}" />
        </StackPanel>
    </Button>
</UserControl>
