<Window
    x:Class="Tek_Mechanical_Keyboard.UI.Main_Window.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sidebar="clr-namespace:Tek_Mechanical_Keyboard.UI.Left_Side_Buttons"
    Title="Tek Mechanical Keyboard"
    Width="1280"
    Height="760"
    MinWidth="900"
    MinHeight="560"
    Background="{StaticResource WindowBackgroundBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Merging MainWindowStyles so Brushes & Button Styles are found  -->
                <ResourceDictionary Source="/Pages/Styles/MainWindowStyles.xaml" />
                <!--  Merging KeymapStyles for key templates  -->
                <ResourceDictionary Source="/Pages/Styles/KeymapStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Border
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="#383838"
        BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="16*" />
                <RowDefinition Height="103*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="20"
                            Height="20"
                            BorderBrush="#454545"
                            BorderThickness="0.5"
                            CornerRadius="3">
                            <Border.Background>
                                <ImageBrush ImageSource="/Pages/Assets/tek_community_logo.jpg" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Tek Keyboard" />
                    </StackPanel>

                    <!--  Minimize Button  -->
                    <Button
                        Grid.Column="1"
                        Click="MinimizeButton_OnClick"
                        Content="&#xE921;"
                        Style="{StaticResource WindowControlButton}" />

                    <!--  Maximize Button  -->
                    <Button
                        Grid.Column="2"
                        Click="MaximizeButton_OnClick"
                        Content="&#xE922;"
                        Style="{StaticResource WindowControlButton}" />

                    <!--  Close Button  -->
                    <Button
                        Grid.Column="3"
                        Click="CloseButton_OnClick"
                        Content="&#xE8BB;"
                        Style="{StaticResource CloseWindowControlButton}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="17*" />
                    <RowDefinition Height="126*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <sidebar:LeftSidePanel
                    x:Name="SidePanel"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Loaded="SidePanel_Loaded"
                    NavigationRequested="SidePanel_OnNavigationRequested" />

                <Border
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                    <Frame
                        x:Name="PageFrame"
                        Background="{StaticResource PageBackgroundBrush}"
                        NavigationUIVisibility="Hidden" />
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>