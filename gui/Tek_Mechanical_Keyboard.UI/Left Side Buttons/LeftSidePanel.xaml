<UserControl
    x:Class="Tek_Mechanical_Keyboard.UI.Left_Side_Buttons.LeftSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Tek_Mechanical_Keyboard.UI.Left_Side_Buttons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="650"
    d:DesignWidth="250"
    mc:Ignorable="d">

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Width" Value="250" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Width" Value="72" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid Background="{StaticResource SidebarBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Height="60"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderBrush="#404040"
                    BorderThickness="1"
                    CornerRadius="3">
                    <Border.Background>
                        <ImageBrush ImageSource="/Pages/Assets/tek_community_logo.jpg" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock
                    x:Name="BrandText"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="Tek Keyboard">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button
                    x:Name="SidebarToggleButton"
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SidebarToggleButton_OnClick"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Collapse or expand sidebar">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="ToggleBackground"
                                Background="Transparent"
                                CornerRadius="3">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Text" Value="&#xE76B;" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                                    <Setter Property="Text" Value="&#xE76C;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBackground" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ToggleBackground" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <controls:LeftSideButton
                x:Name="MainButton"
                Click="NavigationButton_OnClick"
                Icon="&#xE80F;"
                IsCompact="{Binding IsCompact, ElementName=Root}"
                PageKey="Main"
                Text="Main" />

            <controls:LeftSideButton
                x:Name="KeymapButton"
                Click="NavigationButton_OnClick"
                Icon="&#xE765;"
                IsCompact="{Binding IsCompact, ElementName=Root}"
                PageKey="Keymap"
                Text="Keymap" />

            <controls:LeftSideButton
                x:Name="LightingButton"
                Click="NavigationButton_OnClick"
                Icon="&#xEA80;"
                IsCompact="{Binding IsCompact, ElementName=Root}"
                PageKey="Lighting"
                Text="Lighting" />

            <controls:LeftSideButton
                x:Name="MacrosButton"
                Click="NavigationButton_OnClick"
                Icon="&#xE8F1;"
                IsCompact="{Binding IsCompact, ElementName=Root}"
                PageKey="Macros"
                Text="Macros" />

            <controls:LeftSideButton
                x:Name="SettingsButton"
                Click="NavigationButton_OnClick"
                Icon="&#xE713;"
                IsCompact="{Binding IsCompact, ElementName=Root}"
                PageKey="Settings"
                Text="Settings" />
        </StackPanel>

        <Border
            x:Name="FooterBorder"
            Grid.Row="2"
            Padding="18,14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock
                FontSize="11"
                Foreground="#777777"
                Text="QMK keyboard configurator" />
        </Border>
    </Grid>
</UserControl>
